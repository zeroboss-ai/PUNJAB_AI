# Copy this file to ".env" and fill it in. NEVER commit or share the real .env.
# (Do not paste these values into chats, screenshots or videos.)

# You can also add your Kotak account(s) inside the terminal: Settings -> Kotak Neo accounts (saved encrypted, several allowed).
# The four values below are then optional. If they are filled in, they show up as an account called ".env file".

NEO_CONSUMER_KEY=
NEO_MOBILE_NUMBER=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=

# Optional. Leave empty and type the 6-digit TOTP in the dashboard each morning (recommended).
# Only fill this if you accept keeping your TOTP secret on this machine.
NEO_TOTP_SECRET=

# Password for the terminal's own login screen (8+ characters)
DASHBOARD_PASSWORD=

# Second lock for real-money mode. Must be exactly "yes" for mode: live to start.
ALLOW_LIVE=no

# Optional: Telegram alerts (see README, "Telegram alerts"). Both are needed.
# TELEGRAM_BOT_TOKEN comes from @BotFather; TELEGRAM_CHAT_ID from tools/telegram_chat_id.py.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
